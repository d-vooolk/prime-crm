# Настройки трансляции камеры (office-camera.ps1). Рабочий файл — C:\ProgramData\PrimeCamera\camera.conf,
# в git его не класть: в нём пароли.

# Адрес камеры в офисной сети (тот, что открывается в VLC). IP закрепить за камерой в роутере
CAMERA_RTSP_URL=rtsp://192.168.1.183:554/user=ЛОГИН&password=ПАРОЛЬ&channel=1&stream=0.sdp

# Сервер CRM (без https://)
SERVER_HOST=crm.prime-auto.by

# Тот же пароль, что CAMERA_SRT_PASSPHRASE в .env на сервере
SRT_PASSPHRASE=

# Необязательно: ширина картинки (высота — по пропорциям) и битрейт.
# Камера отдаёт 2304×2592 (два объектива друг над другом); 1152 — вдвое меньше, хватает для телефона и компьютера
WIDTH=1152
BITRATE_KBPS=1200
