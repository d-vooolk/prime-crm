# Разработка: скопируйте в server/.env.development. В продакшене значения задаются в .env
# рядом с docker-compose.yml (см. /.env.example) и передаются контейнеру через compose.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/prime_crm
PORT=3001
NODE_ENV=production
CLIENT_URL=https://yourdomain.com

# Обязательные секреты: без них сервер не запустится
# Длинная случайная строка: openssl rand -hex 32
JWT_SECRET=
MASTER_EMAIL=
MASTER_PASSWORD=

# Пуш-уведомления PWA (npx web-push generate-vapid-keys). Пусто — пуши выключены
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Тревожная кнопка (.deploy/README-panic.md): npm run panic:keygen / npm run panic:pin
PANIC_PUBLIC_KEY=
PANIC_PIN_HASH=
# Куда класть зашифрованный архив (по умолчанию — папка panic рядом с uploads)
PANIC_DIR=
# Папка бэкапов, которую кнопка очищает. Пусто — бэкапы не трогаются
BACKUPS_DIR=

# Каталог загруженных файлов (фото/видео вики и записей). По умолчанию — server/uploads
UPLOADS_DIR=

# Токен стороннего каталога авто. Нужен ТОЛЬКО скрипту `npm run cars:fetch`,
# приложение в рантайме к донору не ходит — данные берутся из своей БД.
CARS_API_TOKEN=

# Общий ключ с магазином vdf.by: приём заказов сотрудников (вкладка «VDF» в бухгалтерии).
# Пусто — приём выключен
VDF_INTEGRATION_KEY=
