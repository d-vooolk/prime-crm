generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  records   Record[]
  cars      Car[]
}

model Car {
  id             String   @id @default(cuid())
  clientId       String
  brand          String
  brandId        String
  model          String
  modelId        String
  generation     String?
  generationId   String?
  generationName String?
  year           String
  plateNumber    String?
  mileage        String?
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  records        Record[]

  @@unique([clientId, brandId, modelId, year])
}

model Record {
  id                 String       @id @default(cuid())
  clientId           String
  carId              String
  scheduledAt        DateTime
  serviceman         String
  receptionist       String?
  notes              String?
  documentNumber     String?      @unique
  status             RecordStatus @default(ACTIVE)
  smsLogs            SmsLog[]
  isLegalEntity                Boolean      @default(false)
  legalCompanyName             String?
  legalAddress                 String?
  legalActualAddress           String?
  legalPostalAddress           String?
  legalBankDetails             String?
  legalBic                     String?
  legalUnp                     String?
  legalOkpo                    String?
  legalPhone                   String?
  legalEmail                   String?
  legalRepresentativePosition          String?
  legalRepresentativePositionGenitive  String?
  legalRepresentative                  String?
  legalRepresentativeGenitive          String?
  legalBasis                           String?
  legalVin                     String?
  legalEndDate                 String?
  executorSignatoryName                String?
  executorSignatoryNameGenitive        String?
  executorSignatoryPosition            String?
  executorSignatoryPositionGenitive    String?
  executorSignatoryBasis               String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  client             Client       @relation(fields: [clientId], references: [id])
  car                Car          @relation(fields: [carId], references: [id])
  items              RecordItem[]
  deal               Deal?
}

enum RecordStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

model RecordItem {
  id              String     @id @default(cuid())
  recordId        String
  serviceId       String
  price           Float
  quantity        Int        @default(1)
  netProfit       Float?
  servicemanName  String?
  servicemanSplit Json?
  equipmentId     String?
  prepaidAmount   Float   @default(0)
  prepaidByCard   Boolean @default(false)
  record          Record     @relation(fields: [recordId], references: [id], onDelete: Cascade)
  service         Service    @relation(fields: [serviceId], references: [id])
  equipment       Equipment? @relation(fields: [equipmentId], references: [id])
}

model Service {
  id            String       @id @default(cuid())
  name          String
  categoryId    String
  standardPrice Float
  estimatedTime Int
  isActive      Boolean      @default(true)
  hasEquipment  Boolean      @default(false)
  isProduct     Boolean      @default(false)
  customPercent Float?
  category      Category     @relation(fields: [categoryId], references: [id])
  recordItems   RecordItem[]
}

model Category {
  id                String             @id @default(cuid())
  name              String             @unique
  color             String?
  customPercent     Float?
  services          Service[]
  documentTemplates DocumentTemplate[]
}

model Deal {
  id                  String          @id @default(cuid())
  recordId            String          @unique
  finalPrice          Float
  priceIncreaseReason String?
  defects             String?
  warranty            String?
  isPaidByBankTransfer Boolean        @default(false)
  splitCashAmount     Float?
  splitCardAmount     Float?
  closedAt            DateTime        @default(now())
  salaryDate          DateTime?
  record              Record          @relation(fields: [recordId], references: [id])
  equipment           DealEquipment[]
}

model DealEquipment {
  id          String    @id @default(cuid())
  dealId      String
  equipmentId String
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
}

model Equipment {
  id             String          @id @default(cuid())
  name           String          @unique
  warranty       String?
  wholesalePrice Float?
  retailPrice    Float?
  isActive       Boolean         @default(true)
  deals          DealEquipment[]
  recordItems    RecordItem[]
}

model Serviceman {
  id             String   @id @default(cuid())
  name           String   @unique
  position       String?
  role           String?
  email          String?
  password       String?
  photoUrl       String?
  isDismissed    Boolean   @default(false)
  isReceptionist Boolean   @default(false)
  isDefault      Boolean   @default(false)
  profitPercent  Float     @default(0)
  plainPassword  String?
  birthday       DateTime?
  createdAt      DateTime  @default(now())
  notes          Note[]
}

model CompanySettings {
  id                 String  @id @default(cuid())
  name                  String
  directorName                  String?
  directorNameGenitive          String?
  directorPosition              String?
  directorPositionGenitive      String?
  directorBasis                 String?
  authorizedPersons             Json?
  legalAddress          String?
  actualAddress      String?
  postalAddress      String?
  phone              String?
  email              String?
  taxId              String?
  bic                String?
  okpo               String?
  bankDetails        String?
  logoUrl            String?
  documentPrefix     String  @default("ПА")
  nextDocumentNumber Int     @default(1)
}

enum SmsType {
  ON_CREATE
  REMINDER
  CAR_READY
  REVIEW_REQUEST
}

model SmsSettings {
  id                    String  @id @default(cuid())
  enabled               Boolean @default(false)
  username              String  @default("")
  password              String  @default("")
  onCreateTemplate      String  @default("Здравствуйте, {{clientName}}! Вы записаны на {{date}} в {{time}}. {{carBrand}} {{carModel}}{{plateNumber}}. Ждём вас! {{companyName}}")
  reminderTemplate      String  @default("Напоминаем о записи завтра {{date}} в {{time}}. {{carBrand}} {{carModel}}{{plateNumber}}. До встречи! {{companyName}}")
  carReadyTemplate      String  @default("Здравствуйте, {{clientName}}! Ваш {{carBrand}} {{carModel}}{{plateNumber}} готов к выдаче. Ждём вас! {{companyName}}")
  reviewRequestTemplate String  @default("Здравствуйте, {{clientName}}! Будем благодарны за ваш отзыв о нашей работе. {{companyName}}")
}

model SmsLog {
  id         String   @id @default(cuid())
  recordId   String
  type       SmsType
  phone      String
  message    String
  status     String
  externalId String?
  error      String?
  sentAt     DateTime @default(now())
  record     Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model DocumentTemplate {
  id         String    @id @default(cuid())
  name       String
  type       String    @default("work_order")
  content    String
  isDefault  Boolean   @default(false)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

enum CashTransactionType {
  INCOME
  INCOME_RS
  EXPENSE
  MANUAL_INCOME
}

model CashTransaction {
  id          String              @id @default(cuid())
  type        CashTransactionType
  date        DateTime
  amount      Float
  clientName  String?
  clientPhone String?
  carInfo     String?
  description String?
  person      String?
  recordId     String?
  isPrepayment Boolean             @default(false)
  createdAt    DateTime            @default(now())
}

enum CapitalTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum SalaryAdjustmentType {
  FINE
  BONUS
}

model FounderSalary {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  person    String
  amount    Float
  createdAt DateTime @default(now())
}

model SalaryAdjustment {
  id             String                @id @default(cuid())
  servicemanName String
  type           SalaryAdjustmentType
  amount         Float
  reason         String
  year           Int
  month          Int
  createdAt      DateTime              @default(now())
}

model CapitalTransaction {
  id          String                 @id @default(cuid())
  type        CapitalTransactionType
  date        DateTime
  amountByn   Float?
  amountUsd   Float?
  description String?
  person      String?
  createdAt   DateTime               @default(now())
}

enum NotePriority {
  LOW
  MEDIUM
  HIGH
}

model MonthlyRevenue {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

model Note {
  id           String       @id @default(cuid())
  servicemanId String
  text         String
  date         DateTime?
  allDay       Boolean      @default(true)
  time         String?
  repeat       String?
  priority     NotePriority @default(MEDIUM)
  isDone       Boolean      @default(false)
  doneAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  serviceman   Serviceman   @relation(fields: [servicemanId], references: [id], onDelete: Cascade)
}
