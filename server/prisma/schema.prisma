generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  records   Record[]
  cars      Car[]
}

model Car {
  id             String   @id @default(cuid())
  clientId       String
  brand          String
  brandId        String
  model          String
  modelId        String
  generation     String?
  generationId   String?
  generationName String?
  year           String
  plateNumber    String?
  mileage        String?
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  records        Record[]

  @@unique([clientId, brandId, modelId, year])
}

model Record {
  id                 String       @id @default(cuid())
  clientId           String
  carId              String
  scheduledAt        DateTime
  // Мастер и приёмщик хранятся по ФИО (так считается зарплата), но это внешний ключ на
  // Serviceman.name с ON UPDATE CASCADE: переименование сотрудника переносится во всю историю
  serviceman         String?
  receptionist       String?
  // Откуда пришёл клиент — для статистики каналов привлечения (справочник в настройках)
  clientSourceId     String?
  notes              String?
  // Обнаруженные недостатки: пишет любая роль прямо в карточке записи, печатаются в акте
  defects            String?
  documentNumber     String?      @unique
  // Случайный код страницы записи для клиента (zapis.prime-auto.by/<код>). Страница
  // открывается, только пока запись активна (services/publicRecord.service.ts)
  publicToken        String?      @unique
  status             RecordStatus @default(ACTIVE)
  // Запись перенесена из старой программы (имя файла заявки): только история клиента — без сделки,
  // не правится и не входит в статистику (дашборд, источники, календарь). bootstrap/legacyVisitsImport.ts
  importKey          String?      @unique
  smsLogs            SmsLog[]
  isLegalEntity                Boolean      @default(false)
  legalCompanyName             String?
  legalAddress                 String?
  legalActualAddress           String?
  legalPostalAddress           String?
  legalBankDetails             String?
  legalBic                     String?
  legalUnp                     String?
  legalOkpo                    String?
  legalPhone                   String?
  legalEmail                   String?
  legalRepresentativePosition          String?
  legalRepresentativePositionGenitive  String?
  legalRepresentative                  String?
  legalRepresentativeGenitive          String?
  legalBasis                           String?
  legalVin                     String?
  legalEndDate                 String?
  executorSignatoryName                String?
  executorSignatoryNameGenitive        String?
  executorSignatoryPosition            String?
  executorSignatoryPositionGenitive    String?
  executorSignatoryBasis               String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  client             Client       @relation(fields: [clientId], references: [id])
  car                Car          @relation(fields: [carId], references: [id])
  items              RecordItem[]
  deal               Deal?
  media              RecordMedia[]
  siteLeads          SiteLead[]
  servicemanRef      Serviceman?  @relation("RecordServiceman", fields: [serviceman], references: [name], onUpdate: Cascade, onDelete: Restrict)
  receptionistRef    Serviceman?  @relation("RecordReceptionist", fields: [receptionist], references: [name], onUpdate: Cascade, onDelete: Restrict)
  clientSource       ClientSource? @relation(fields: [clientSourceId], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@index([clientId])
  @@index([carId])
  @@index([clientSourceId])
}

// Справочник источников клиента (Настройки → Источники клиентов). Источник, который уже
// стоит в записях, не удаляется, а скрывается из списка — статистика каналов сохраняется
model ClientSource {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  records   Record[]
}

enum RecordMediaType {
  PHOTO
  VIDEO
}

// Фото и видео нюансов авто в записи. Хранятся год (expiresAt), потом файл и строка
// удаляются фоновой очисткой (services/recordMedia.service.ts)
// Заявка с сайта prime-auto.by (форма «Оставить заявку»), приходит по ключу SITE_LEADS_KEY
model SiteLead {
  id            String         @id @default(cuid())
  name          String
  phone         String
  message       String?
  // Страница сайта, с которой отправили, и откуда человек пришёл на сайт
  page          String?
  source        String?
  // Фото фары — имена файлов в UPLOADS_DIR/site-leads; при записи копируются в фото записи
  photos        String[]
  status        SiteLeadStatus @default(NEW)
  handledAt     DateTime?
  handledByName String?
  recordId      String?
  record        Record?        @relation(fields: [recordId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())

  @@index([status, createdAt])
}

enum SiteLeadStatus {
  NEW // ждёт ответа
  DONE // обработана без записи (перезвонили, подсказали)
  RECORDED // по заявке создана запись
}

model RecordMedia {
  id             String          @id @default(cuid())
  recordId       String
  type           RecordMediaType
  filename       String          @unique // имя файла в UPLOADS_DIR/records
  originalName   String
  size           Int
  uploadedByName String?
  createdAt      DateTime        @default(now())
  expiresAt      DateTime
  // Сжатие (utils/recordMediaOptimize.ts): фото — сразу при загрузке, видео — в фоне.
  // Пока видео перекодируется, processing = true и отдаётся оригинал
  processing     Boolean         @default(false)
  optimized      Boolean         @default(false)
  thumbFilename  String? // превью для сетки (фото) или кадр-обложка (видео), в UPLOADS_DIR/records
  record         Record          @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([expiresAt])
}

enum RecordStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

model RecordItem {
  id              String     @id @default(cuid())
  recordId        String
  serviceId       String
  price           Decimal @db.Decimal(14, 2)
  quantity        Int        @default(1)
  netProfit       Decimal? @db.Decimal(14, 2)
  servicemanName  String?
  servicemanSplit Json?
  equipmentId     String?
  prepaidAmount   Decimal @db.Decimal(14, 2)   @default(0)
  prepaidByCard   Boolean @default(false)
  // Предоплата в валюте: prepaidAmount — эквивалент в BYN, здесь исходная сумма и курс
  prepaidCurrency       String?
  prepaidCurrencyAmount Decimal? @db.Decimal(14, 2)
  prepaidRate           Float?
  record          Record     @relation(fields: [recordId], references: [id], onDelete: Cascade)
  service         Service    @relation(fields: [serviceId], references: [id])
  equipment       Equipment? @relation(fields: [equipmentId], references: [id])
  servicemanRef   Serviceman? @relation("RecordItemServiceman", fields: [servicemanName], references: [name], onUpdate: Cascade, onDelete: Restrict)

  @@index([recordId])
  @@index([serviceId])
}

model Service {
  id            String       @id @default(cuid())
  name          String
  categoryId    String
  standardPrice Decimal @db.Decimal(14, 2)
  estimatedTime Int
  isActive      Boolean      @default(true)
  hasEquipment  Boolean      @default(false)
  isProduct     Boolean      @default(false)
  customPercent Float?
  // Тип ремонта: по нему на странице записи для клиента показываются описание, фото и вопросы
  repairTypeId  String?
  // Не предлагать в «Открытых возможностях» карточки записи (Настройки → Открытые возможности)
  excludeFromOpportunities Boolean @default(false)
  // Раздел вики, который мастер заполняет после такой работы (Настройки → Упущенная прибыль).
  // Нет раздела — после работы заполнять в вики нечего (полировка, оклейка)
  wikiSectionId String?
  category      Category     @relation(fields: [categoryId], references: [id])
  repairType    RepairType?  @relation(fields: [repairTypeId], references: [id], onDelete: SetNull)
  wikiSection   WikiSection? @relation(fields: [wikiSectionId], references: [id], onDelete: SetNull)
  recordItems   RecordItem[]

  @@index([repairTypeId])
  @@index([wikiSectionId])
}

// Тип ремонта (Справочник → Типы ремонта). Услуг много, типов мало: на странице записи
// для клиента блок каждого типа из записи показывается один раз
model RepairType {
  id          String            @id @default(cuid())
  name        String            @unique // название в CRM и заголовок блока на странице
  description String            @default("")
  // Вопросы и ответы: [{ question, answer }]
  faq         Json              @default("[]")
  // Ссылки (например, на prime-auto.by): [{ title, url }]
  links       Json              @default("[]")
  sortOrder   Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  services    Service[]
  photos      RepairTypePhoto[]
}

// Фото предстоящей работы. Файл — в UPLOADS_DIR/repair-types
model RepairTypePhoto {
  id           String     @id @default(cuid())
  repairTypeId String
  filename     String     @unique
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  repairType   RepairType @relation(fields: [repairTypeId], references: [id], onDelete: Cascade)

  @@index([repairTypeId])
}

model Category {
  id                String             @id @default(cuid())
  name              String             @unique
  color             String?
  customPercent     Float?
  services          Service[]
  documentTemplates DocumentTemplate[]
}

model Deal {
  id                  String          @id @default(cuid())
  recordId            String          @unique
  finalPrice          Decimal @db.Decimal(14, 2)
  priceIncreaseReason String?
  // Рекомендации клиенту — печатаются в акте под обнаруженными недостатками (Record.defects)
  recommendations     String?
  warranty            String?
  isPaidByBankTransfer Boolean        @default(false)
  splitCashAmount     Decimal? @db.Decimal(14, 2)
  splitCardAmount     Decimal? @db.Decimal(14, 2)
  // Часть оплаты в валюте: [{ currency, amount, rate }], сумма в BYN = amount × rate
  currencyPayments    Json?
  closedAt            DateTime        @default(now())
  record              Record          @relation(fields: [recordId], references: [id])
  equipment           DealEquipment[]
  salaryTransfers     DealSalaryTransfer[]

  @@index([closedAt])
}

// Перенос доли сотрудника в сделке в расчёт ЗП другого месяца (по умолчанию — месяц по дате закрытия).
// У каждого сотрудника свой: перенос одному не трогает расчёт остальных участников сделки
model DealSalaryTransfer {
  id             String     @id @default(cuid())
  dealId         String
  servicemanName String
  // Расчётный месяц ЗП (с 25-го прошлого по 24-е этого)
  year           Int
  month          Int
  deal           Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  serviceman     Serviceman @relation(fields: [servicemanName], references: [name], onUpdate: Cascade, onDelete: Restrict)

  @@unique([dealId, servicemanName])
  @@index([servicemanName, year, month])
}

model DealEquipment {
  id          String    @id @default(cuid())
  dealId      String
  equipmentId String
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
}

model Equipment {
  id             String          @id @default(cuid())
  name           String          @unique
  warranty       String?
  wholesalePrice Decimal? @db.Decimal(14, 2)
  retailPrice    Decimal? @db.Decimal(14, 2)
  isActive       Boolean         @default(true)
  deals          DealEquipment[]
  recordItems    RecordItem[]
}

model Serviceman {
  id             String   @id @default(cuid())
  name           String   @unique
  position       String?
  role           String?
  email          String?
  password       String?
  photoUrl       String?
  isDismissed    Boolean   @default(false)
  isReceptionist Boolean   @default(false)
  isDefault      Boolean   @default(false)
  // Показывать в списке исполнителей работ. null — старая запись, заполняется
  // при старте сервера (bootstrap/servicemanPerformers.ts)
  isPerformer    Boolean?
  // Участвует в дашборде (карточки, пьедестал, упущенная прибыль); лишних скрывают в настройках
  showInDashboard Boolean  @default(true)
  // Начисления учитываются в «Зарплатном фонде» бухгалтерии; снимают, например, у учредителей
  inSalaryFund   Boolean   @default(true)
  profitPercent  Float     @default(0)
  birthday       DateTime?
  createdAt      DateTime  @default(now())
  notes          Note[]
  salaryRates    SalaryRate[]
  // Ссылки по ФИО (см. Record.serviceman) — для каскадного переименования
  recordsAsServiceman   Record[]                @relation("RecordServiceman")
  recordsAsReceptionist Record[]                @relation("RecordReceptionist")
  recordItems           RecordItem[]            @relation("RecordItemServiceman")
  salaryPayments        EmployeeSalaryPayment[]
  salaryAdjustments     SalaryAdjustment[]
  founderSalaries       FounderSalary[]
  dealSalaryTransfers   DealSalaryTransfer[]
}

// История оклада: сумма действует с расчётного месяца year/month до следующей записи
model SalaryRate {
  id           String     @id @default(cuid())
  servicemanId String
  year         Int
  month        Int
  amount       Decimal @db.Decimal(14, 2)
  createdAt    DateTime   @default(now())
  serviceman   Serviceman @relation(fields: [servicemanId], references: [id], onDelete: Cascade)

  @@unique([servicemanId, year, month])
}

model CompanySettings {
  id                 String  @id @default(cuid())
  name                  String
  directorName                  String?
  directorNameGenitive          String?
  directorPosition              String?
  directorPositionGenitive      String?
  directorBasis                 String?
  authorizedPersons             Json?
  legalAddress          String?
  actualAddress      String?
  postalAddress      String?
  phone              String?
  email              String?
  taxId              String?
  bic                String?
  okpo               String?
  bankDetails        String?
  logoUrl            String?
  documentPrefix     String  @default("ПА")
  nextDocumentNumber Int     @default(1)
  // Памятка клиенту в акте выполненных работ. null — текст по умолчанию, "" — не печатать
  actMemo            String?
  // Памятка блоками: [{ id, title, text, targets: ['svc:<id>' | 'cat:<id>'] }]. Блок печатается,
  // если в записи есть одна из услуг targets (пусто — всегда). null — берётся actMemo
  actMemoBlocks      Json?
}

enum SmsType {
  ON_CREATE
  REMINDER
  CAR_READY
  REVIEW_REQUEST
}

model SmsSettings {
  id                    String  @id @default(cuid())
  enabled               Boolean @default(false)
  token                 String  @default("")
  alphanameId           String  @default("")
  alphaname             String  @default("")
  onCreateTemplate      String  @default("Здравствуйте, {{clientName}}! Вы записаны на {{date}} в {{time}}. {{carBrand}} {{carModel}}{{plateNumber}}. Ждём вас! {{companyName}}")
  reminderTemplate      String  @default("Напоминаем о записи завтра {{date}} в {{time}}. {{carBrand}} {{carModel}}{{plateNumber}}. До встречи! {{companyName}}")
  carReadyTemplate      String  @default("Здравствуйте, {{clientName}}! Ваш {{carBrand}} {{carModel}}{{plateNumber}} готов к выдаче. Ждём вас! {{companyName}}")
  reviewRequestTemplate String  @default("Здравствуйте, {{clientName}}! Будем благодарны за ваш отзыв о нашей работе. {{companyName}}")
}

model SmsLog {
  id         String   @id @default(cuid())
  recordId   String
  type       SmsType
  phone      String
  message    String
  status     String
  externalId String?
  error      String?
  sentAt     DateTime @default(now())
  record     Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model DocumentTemplate {
  id         String    @id @default(cuid())
  name       String
  type       String    @default("work_order")
  content    String
  isDefault  Boolean   @default(false)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

enum CashTransactionType {
  INCOME
  INCOME_RS
  EXPENSE
  MANUAL_INCOME
}

model CashTransaction {
  id          String              @id @default(cuid())
  type        CashTransactionType
  date        DateTime
  amount      Decimal @db.Decimal(14, 2)
  clientName  String?
  clientPhone String?
  carInfo     String?
  description String?
  person      String?
  recordId     String?
  isPrepayment Boolean             @default(false)
  // Приход в валюте: amount — сумма в BYN по курсу, здесь — исходная валюта и курс.
  // Такую валюту сразу отчисляем в капитал (см. capitalTransferExpense)
  currency       String?           // USD | EUR
  currencyAmount Decimal? @db.Decimal(14, 2)
  currencyRate   Float?
  // Расход «Отчисление в капитал» за этот валютный приход. Удаляется вместе с приходом
  linkedIncomeId         String?          @unique
  linkedIncome           CashTransaction? @relation("CurrencyIncomeTransfer", fields: [linkedIncomeId], references: [id], onDelete: Cascade)
  capitalTransferExpense CashTransaction? @relation("CurrencyIncomeTransfer")
  createdAt    DateTime            @default(now())
  debtPayment  DebtPayment?
  founderSalary FounderSalary?
  salaryPayment EmployeeSalaryPayment?
  // Пополнение капитала, которым стал этот расход (отчисление в капитал)
  capitalTransfer CapitalTransaction?
  // Оплата заказа сотрудника из магазина vdf.by, которой создан этот расход
  vdfOrderPayment VdfOrderPayment?
  // Категория затрат (только для обычных расходов, у системных — пусто)
  expenseCategoryId String?
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([recordId])
}

// Справочник категорий затрат для расходов кассы (расходники, поставщики, еда в офис …)
model ExpenseCategory {
  id           String            @id @default(cuid())
  name         String            @unique
  sortOrder    Int?
  createdAt    DateTime          @default(now())
  transactions CashTransaction[]
  debts        Debt[]
}

enum VdfOrderStatus {
  PENDING  // ждёт исполнения
  EXECUTED // исполнен: в кассе расход с категорией «vdf.by»
  CANCELLED // отменён в бухгалтерии: оплаты не будет, магазин видит отмену
}

// Заказ сотрудника из магазина vdf.by. Магазин присылает его, когда заказ отмечен «Выполнен»,
// и отзывает, если отметку сняли. Исполнение создаёт расход в кассе: на весь остаток
// (заказ исполнен) или на часть (заказ ждёт дальше с меньшим остатком).
model VdfOrder {
  id                String           @id @default(cuid())
  shopOrderId       Int              @unique
  status            VdfOrderStatus   @default(PENDING)
  employeeName      String
  employeePhone     String?
  items             Json             // [{ title, options, sku, qty, price, sum }]
  shopTotal         Decimal          @db.Decimal(14, 2)
  // Сумма расхода. До исполнения её можно поправить; поправленную магазин уже не перезаписывает
  amount            Decimal          @db.Decimal(14, 2)
  amountEdited      Boolean          @default(false)
  completedAt       DateTime         // когда заказ отметили «Выполнен» в магазине
  // В магазине сняли «Выполнен», когда расход уже создан: решение по расходу за администратором
  shopCancelled     Boolean          @default(false)
  executedAt        DateTime?
  executedByName    String?
  payments          VdfOrderPayment[]
  cancelledAt       DateTime?
  cancelledByName   String?
  cancelReason      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
}

// Оплата заказа vdf.by — расход в кассе. Сумма — у расхода; удалили расход — оплаты нет
model VdfOrderPayment {
  id                String          @id @default(cuid())
  orderId           String
  order             VdfOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashTransactionId String          @unique
  cashTransaction   CashTransaction @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)
  paidByName        String?
  createdAt         DateTime        @default(now())

  @@index([orderId])
}

enum CapitalTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum SalaryAdjustmentType {
  FINE
  BONUS
}

model FounderSalary {
  id                String           @id @default(cuid())
  year              Int
  month             Int
  person            String
  amount            Decimal @db.Decimal(14, 2)
  createdAt         DateTime         @default(now())
  // Расход в кассе, которым выдана эта ЗП. Сумма синхронизируется при правке расхода,
  // при удалении расхода запись удаляется вместе с ним
  cashTransactionId String?          @unique
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)
  serviceman        Serviceman       @relation(fields: [person], references: [name], onUpdate: Cascade, onDelete: Restrict)
}

enum SalaryPaymentType {
  ADVANCE // Аванс — выплачено меньше остатка за период
  FINAL   // Расчёт — выплачен весь остаток
}

// Выплата ЗП сотруднику за расчётный период (year/month — как у SalaryAdjustment)
model EmployeeSalaryPayment {
  id                String            @id @default(cuid())
  servicemanName    String
  year              Int
  month             Int
  type              SalaryPaymentType
  // Вся выплата: наличные + карта. Остаток сотрудника уменьшается на неё целиком
  amount            Decimal @db.Decimal(14, 2)
  // Часть, переведённая на карту. В кассу (только наличные) не попадает
  cardAmount        Decimal @db.Decimal(14, 2)             @default(0)
  date              DateTime          @default(now())
  createdAt         DateTime          @default(now())
  // Расход в кассе на наличную часть (amount - cardAmount). Нет, если всё выплачено на карту.
  // При правке суммы расхода меняется наличная часть, при удалении расхода выплата удаляется
  cashTransactionId String?           @unique
  cashTransaction   CashTransaction?  @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)
  serviceman        Serviceman        @relation(fields: [servicemanName], references: [name], onUpdate: Cascade, onDelete: Restrict)

  @@index([servicemanName, year, month])
}

model SalaryAdjustment {
  id             String                @id @default(cuid())
  servicemanName String
  type           SalaryAdjustmentType
  amount         Decimal @db.Decimal(14, 2)
  reason         String
  year           Int
  month          Int
  createdAt      DateTime              @default(now())
  serviceman     Serviceman            @relation(fields: [servicemanName], references: [name], onUpdate: Cascade, onDelete: Restrict)

  @@index([servicemanName, year, month])
}

model CapitalTransaction {
  id          String                 @id @default(cuid())
  type        CapitalTransactionType
  date        DateTime
  amountByn   Decimal? @db.Decimal(14, 2)
  amountUsd   Decimal? @db.Decimal(14, 2)
  amountEur   Decimal? @db.Decimal(14, 2)
  // Курс BYN за единицу валюты, если деньги пришли через конвертацию
  rate        Float?
  description String?
  person      String?
  createdAt   DateTime               @default(now())
  // Расход в кассе «Отчисление в капитал», из которого пришло пополнение. Удаляется вместе с ним
  cashTransactionId String?          @unique
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)
  debtPayment       DebtPayment?
}

enum DebtDirection {
  WE_OWE
  OWED_TO_US
}

enum DebtStatus {
  ACTIVE
  SETTLED
}

model Debt {
  id              String        @id @default(cuid())
  description     String
  // Суммы — в валюте долга
  currency        String        @default("BYN") // BYN | USD | EUR
  initialAmount   Decimal @db.Decimal(14, 2)
  remainingAmount Decimal @db.Decimal(14, 2)
  direction       DebtDirection
  status          DebtStatus    @default(ACTIVE)
  createdAt       DateTime      @default(now())
  settledAt       DateTime?
  payments        DebtPayment[]
  // Категория затрат: погашения долга «мы должны» попадают в аналитику расходов по ней,
  // а не в общую группу «Погашение долгов»
  expenseCategoryId String?
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
}

model DebtPayment {
  id                String           @id @default(cuid())
  debtId            String
  // На сколько уменьшился долг — в валюте долга
  amount            Decimal @db.Decimal(14, 2)
  // Чем фактически платили: валюта, сумма и курс BYN за единицу (если была конвертация)
  paidCurrency      String           @default("BYN")
  paidAmount        Decimal? @db.Decimal(14, 2)
  rate              Float?
  paidAt            DateTime         @default(now())
  cashTransactionId String?          @unique
  // Мы отдали валюту — она списана из капитала
  capitalTransactionId String?             @unique
  debt              Debt             @relation(fields: [debtId], references: [id], onDelete: Cascade)
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id], onDelete: SetNull)
  capitalTransaction CapitalTransaction? @relation(fields: [capitalTransactionId], references: [id], onDelete: SetNull)
}

enum NoteProject {
  CRM
  PRIME
  VDF
}

model MonthlyRevenue {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  amount    Decimal @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

model MonthlyRecordCount {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  count     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

model Note {
  id           String       @id @default(cuid())
  servicemanId String
  text         String
  date         DateTime?
  allDay       Boolean      @default(true)
  time         String?
  repeat       String?
  project      NoteProject  @default(CRM)
  isDone       Boolean      @default(false)
  doneAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  serviceman   Serviceman   @relation(fields: [servicemanId], references: [id], onDelete: Cascade)
}

// --- Локальный справочник автомобилей ---
// Копия стороннего каталога (auto-data.api-home.ru), который постоянно отваливался.
// Заполняется из снапшота prisma/data/cars-catalog.json скриптом `npm run cars:seed`.
// externalId — идентификатор донора; именно он лежит в Car.brandId/modelId/generationId,
// поэтому наружу отдаём всегда его, а не суррогатный ключ.

// SNAPSHOT — приехало из снапшота донора, перезаписывается при обновлении каталога.
// MANUAL   — заведено руками (грузовые и всё, чего нет у донора). Синхронизация
//            снапшота такие записи не трогает никогда.
enum CatalogSource {
  SNAPSHOT
  MANUAL
}

model CarMark {
  id       String        @id // externalId донора либо slug для ручных записей
  name     String
  yearFrom Int?
  yearTo   Int?
  logo     String?
  source   CatalogSource @default(SNAPSHOT)
  models   CarModel[]

  @@index([name])
  @@index([source])
}

model CarModel {
  id          String          @id @default(cuid())
  externalId  String
  markId      String
  name        String
  yearFrom    Int?
  yearTo      Int?
  source      CatalogSource   @default(SNAPSHOT)
  mark        CarMark         @relation(fields: [markId], references: [id], onDelete: Cascade)
  generations CarGeneration[]

  @@unique([markId, externalId])
  @@index([name])
  @@index([source])
}

model CarGeneration {
  id         String        @id @default(cuid())
  externalId String
  modelId    String
  name       String
  yearFrom   Int?
  yearTo     Int?
  photo      String?
  source     CatalogSource @default(SNAPSHOT)
  model      CarModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, externalId])
  @@index([source])
}

// --- Wiki по автомобилям ---
// Карточка привязана к тем же внешним id донора, что и Car.brandId/modelId/generationId,
// поэтому из записи на запись вики переходим без поиска по названиям.
// Названия дублируются в карточке: справочник может обновиться, а подпись в списке правок должна остаться.
model WikiEntry {
  id             String         @id @default(cuid())
  markId         String
  modelId        String
  generationId   String
  markName       String
  modelName      String
  generationName String?
  content        String         @default("")
  legacyId       Int?           @unique // id карточки в старой вике (wiki.prime-auto.by)
  updatedByName  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  media          WikiMedia[]
  revisions      WikiRevision[]
  sections       WikiEntrySection[]
  products       WikiProduct[]

  @@unique([markId, modelId, generationId])
}

// Раздел карточки вики по виду работ («Bi-Led модули», «Ремонт ДХО»). Общий текст карточки
// (WikiEntry.content) — раздел «Общее», отдельной строки у него нет.
// К разделу привязаны услуги: закрыта сделка с такой услугой, а раздел у этого авто пуст —
// мастер упустил премию за вики (accounting/missedWiki.logic.ts)
model WikiSection {
  id        String             @id @default(cuid())
  name      String             @unique
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  services  Service[]
  contents  WikiEntrySection[]
  media     WikiMedia[]
  revisions WikiRevision[]
  products  WikiProduct[]
}

// Текст раздела в карточке. Раздел с текстом или файлами удалить нельзя (Restrict)
model WikiEntrySection {
  id            String      @id @default(cuid())
  entryId       String
  sectionId     String
  content       String      @default("")
  updatedByName String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  entry         WikiEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  section       WikiSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([entryId, sectionId])
  @@index([sectionId])
}

enum WikiMediaType {
  PHOTO
  VIDEO
}

model WikiMedia {
  id             String        @id @default(cuid())
  entryId        String
  type           WikiMediaType
  filename       String        @unique // имя файла в UPLOADS_DIR/wiki
  originalName   String
  size           Int
  uploadedByName  String?
  // Раздел карточки; null — «Общее»
  sectionId       String?
  createdAt       DateTime      @default(now())
  // Сжатые варианты фото (UPLOADS_DIR/wiki/variants/<имя файла без расширения>/).
  // Нет вариантов (видео, HEIC, битый файл) — показываем оригинал.
  width           Int?
  height          Int?
  placeholder     String? // крошечное размытое превью, data:image/webp;base64
  thumbFilename   String? // путь относительно UPLOADS_DIR/wiki
  displayFilename String? // JPEG-копия HEIC: её показывает браузер вместо оригинала
  mediumFilename  String?
  variantsVersion Int           @default(0) // версия параметров сжатия, 0 — ещё не обрабатывали
  entry           WikiEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  section         WikiSection?  @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([sectionId])
}

// Товар магазина vdf.by, прикреплённый к разделу карточки (ссылка на сайт).
// Название и картинка — снимок на момент прикрепления, цену смотрят на сайте
model WikiProduct {
  id          String       @id @default(cuid())
  entryId     String
  // Раздел карточки; null — «Общее»
  sectionId   String?
  productId   String // id товара в vdf.by
  title       String
  url         String
  imageUrl    String?
  addedByName String?
  createdAt   DateTime     @default(now())
  entry       WikiEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  section     WikiSection? @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([sectionId])
}

enum WikiRevisionStatus {
  PENDING  // ждёт проверки
  REVIEWED // просмотрено без премии
  REWARDED // назначена премия
}

// Правка сотрудника. Пока правка не проверена, последующие сохранения того же автора
// по тому же разделу карточки дописываются в неё: prevContent остаётся исходным, newContent обновляется.
model WikiRevision {
  id                 String             @id @default(cuid())
  entryId            String
  authorId           String
  authorName         String
  authorRole         String?
  // Раздел карточки; null — «Общее». Удалённый раздел оставляет правку в истории
  sectionId          String?
  prevContent        String
  newContent         String
  addedMedia         Json?              // [{ id, type, filename, originalName }]
  removedMedia       Json?              // [{ id, type, filename, originalName }]
  status             WikiRevisionStatus @default(PENDING)
  reviewedByName     String?
  reviewedAt         DateTime?
  bonusAmount        Decimal? @db.Decimal(14, 2)
  bonusBaseAmount    Decimal? @db.Decimal(14, 2) // размер премии из настроек на момент назначения — видно, что оплачено частично
  salaryAdjustmentId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  entry              WikiEntry          @relation(fields: [entryId], references: [id], onDelete: Cascade)
  section            WikiSection?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([entryId])
}

model WikiSettings {
  id          String @id @default(cuid())
  bonusAmount Decimal @db.Decimal(14, 2)  @default(0)
}

// --- Журнал изменений денег ---
// Пишется автоматически расширением Prisma (src/prisma/audit.ts) на каждое изменение
// кассы, капитала, долгов, сделок и зарплат. В интерфейсе не показывается — смотреть через psql:
//   SELECT * FROM "AuditLog" ORDER BY "createdAt" DESC LIMIT 50;
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String?
  userName  String?
  action    String // create | update | delete
  model     String
  entityId  String?
  before    Json?
  after     Json?

  @@index([createdAt])
  @@index([model, entityId])
}

// --- Склад ---
// Дерево категорий произвольной глубины. Товары лежат только в конечных категориях:
// в категорию с подкатегориями нельзя положить товар, а в категорию с товарами — подкатегорию.
model StockCategory {
  id        String          @id @default(cuid())
  name      String
  parentId  String?
  sortOrder Int?
  createdAt DateTime        @default(now())
  parent    StockCategory?  @relation("StockCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  StockCategory[] @relation("StockCategoryTree")
  items     StockItem[]

  @@unique([parentId, name])
  @@index([parentId])
}

model StockItem {
  id            String          @id @default(cuid())
  categoryId    String
  name          String
  sku           String? // артикул
  unit          String          @default("шт")
  quantity      Decimal         @default(0) @db.Decimal(14, 3)
  // Порог напоминания: остаток на нём или ниже — товар «заканчивается». null — не напоминать
  minQuantity   Decimal?        @db.Decimal(14, 3)
  purchasePrice Decimal?        @db.Decimal(14, 2)
  notes         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  category      StockCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements     StockMovement[]

  @@index([categoryId])
  @@index([name])
}

enum StockMovementType {
  IN // приход
  OUT // расход / списание
  ADJUST // инвентаризация: установлен точный остаток
}

model StockMovement {
  id            String            @id @default(cuid())
  itemId        String
  type          StockMovementType
  // Изменение остатка (для ADJUST — разница со старым остатком)
  delta         Decimal           @db.Decimal(14, 3)
  quantityAfter Decimal           @db.Decimal(14, 3)
  comment       String?
  userName      String?
  createdAt     DateTime          @default(now())
  item          StockItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

// --- Пуш-уведомления (PWA) ---
// Подписка одного устройства (браузера) пользователя. userId — id сотрудника или 'master'.
// Мёртвые подписки (браузер ответил 404/410) удаляются при отправке.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  userName  String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// --- Состояние безопасности (одна строка, id = 'singleton') ---
// sessionsRevokedAt — токены, выданные раньше этого момента, недействительны:
// так тревожная кнопка разлогинивает все устройства (src/utils/sessionRevocation.ts)
model SecurityState {
  id                String    @id
  sessionsRevokedAt DateTime?
}

// --- Почта (ящики компании, приём по IMAP: services/mail.service.ts) ---
// Письмо из папки «Входящие». Удаление в CRM не трогает ящик: письмо пропадает только из CRM
model MailMessage {
  id          String           @id @default(cuid())
  account     String           @default("") // адрес ящика (MAIL_USER, MAIL2_USER)
  mailbox     String           // папка в ящике (INBOX)
  uidValidity BigInt
  uid         Int
  messageId   String?          // заголовок Message-ID
  fromName    String?
  fromAddress String?
  to          String?
  subject     String?
  date        DateTime
  preview     String?          // начало текста для списка писем
  text        String?
  html        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  attachments MailAttachment[]

  @@unique([account, mailbox, uidValidity, uid])
  @@index([date])
  @@index([account, isRead])
}

// Вложение письма. Файл — в UPLOADS_DIR/mail, наружу отдаётся только через API с входом
model MailAttachment {
  id          String      @id @default(cuid())
  messageId   String
  filename    String      @unique
  originalName String
  contentType String
  size        Int
  message     MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// До какого UID письма уже забраны. Сменился UIDVALIDITY папки — забираем заново за последние дни
model MailSyncState {
  account     String   @default("")
  mailbox     String
  uidValidity BigInt
  lastUid     Int
  updatedAt   DateTime @updatedAt

  @@id([account, mailbox])
}
