# Секреты для docker compose (продакшен). Скопируйте в .env и заполните — .env не коммитится.
POSTGRES_PASSWORD=
# Длинная случайная строка: openssl rand -hex 32
JWT_SECRET=
# Мастер-доступ (вход без учётки сотрудника)
MASTER_EMAIL=
MASTER_PASSWORD=
# Адрес, с которого открывают CRM (для CORS)
CLIENT_URL=https://crm.example.by
# Внешнее хранилище для бэкапов (rclone remote, например yadisk:prime-crm-backup). Пусто — только локальные
BACKUP_RCLONE_REMOTE=
# Пуш-уведомления PWA. Сгенерировать: npx web-push generate-vapid-keys. Пусто — пуши выключены
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.by
# Тревожная кнопка «Протокол AID» (.deploy/README-panic.md). Ключ и хеш создаются
# на своём компьютере: npm run panic:keygen и npm run panic:pin (в папке server). Пусто — кнопка не работает
PANIC_PUBLIC_KEY=
PANIC_PIN_HASH=
# Приём заказов сотрудников из магазина vdf.by (вкладка «VDF» в бухгалтерии). Тот же ключ —
# CRM_INTEGRATION_KEY в .env магазина. Сгенерировать: openssl rand -hex 32. Пусто — приём выключен
VDF_INTEGRATION_KEY=
